# ═══════════════════════════════════════════════════════════════
#  LLM PROVIDER  —  change only these four lines to swap providers
# ═══════════════════════════════════════════════════════════════
# Supported: gemini | openai | anthropic | ollama | openai_compatible
LLM_PROVIDER=gemini
LLM_API_KEY=paste-your-api-key-here
LLM_MODEL=gemini-2.5-flash
# Required only for openai_compatible / ollama:
#   OpenRouter      https://openrouter.ai/api/v1
#   Groq            https://api.groq.com/openai/v1
#   Ollama          http://localhost:11434/v1
#   vLLM/LM Studio  http://localhost:8000/v1
LLM_BASE_URL=
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=8192

APP_NAME=AI Data Analyst
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change-me-to-a-random-string
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

DATABASE_URL=sqlite+aiosqlite:///./data/app.db
UPLOAD_DIR=./data/uploads
ARTIFACT_DIR=./data/artifacts
DUCKDB_TEMP_DIR=./data/duckdb_temp
MAX_UPLOAD_SIZE_MB=100

DUCKDB_MEMORY_LIMIT=2GB
DUCKDB_THREADS=4

# Set SANDBOX_ENABLED=true only when Docker is available.
SANDBOX_ENABLED=false
SANDBOX_IMAGE=ai-data-analyst-sandbox:latest
SANDBOX_CPU_LIMIT=2
SANDBOX_MEMORY_LIMIT_MB=2048
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_NETWORK_DISABLED=true
SANDBOX_MAX_OUTPUT_BYTES=1048576

MAX_QUERY_ROWS=100000
QUERY_TIMEOUT_SECONDS=60
MAX_CONCURRENT_RUNS=5
DISPLAY_TIMEZONE=Asia/Kolkata
# Valid values are any IANA name: Asia/Kolkata, America/New_York, Europe/London, Asia/Dubai, Asia/Tokyo, UTC, etc.
LOG_LEVEL=INFO

# ═══════════════════════════════════════════════════════════════
#  AUTH
# ═══════════════════════════════════════════════════════════════
# false → single-user mode, everything runs as the "anonymous" user.
# true  → register/login required; data is scoped per user.
AUTH_ENABLED=false

# JWT signing key. Change this in production.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=1440

# Minimum password length when registering
AUTH_MIN_PASSWORD_LENGTH=8

# Password reset
# How long a reset link stays valid.
AUTH_RESET_TOKEN_MINUTES=30

# Dev-only: also return the reset link in the /forgot-password response.
# NEVER enable in production — it lets anyone reset any account.
AUTH_SHOW_RESET_LINK=false
# ═══════════════════════════════════════════════════════════════
#  RATE LIMITING
# ═══════════════════════════════════════════════════════════════
# Disable for local testing of the auth flow. Keep ON in production.
RATE_LIMIT_ENABLED=true

# Limits use the "N/period" format.
# Periods: second | minute | hour | day
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_REGISTER=5/hour
RATE_LIMIT_FORGOT=5/hour
RATE_LIMIT_RESET=10/hour
RATE_LIMIT_CHAT=30/minute
RATE_LIMIT_EXECUTE=60/minute

# Storage backend:
#   memory://               → single-process only (default, dev)
#   redis://localhost:6379  → multi-worker (production)
RATE_LIMIT_STORAGE=memory://

# ═══════════════════════════════════════════════════════════════
#  SMTP (password-reset email delivery)
# ═══════════════════════════════════════════════════════════════
# When false, reset links are logged to the server console only.
# When true, they are emailed to the user's address.
SMTP_ENABLED=false

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@your-domain.com
SMTP_FROM_NAME=AI Data Analyst

# TLS options:
#   Port 587 (STARTTLS) → SMTP_USE_TLS=true,  SMTP_USE_SSL=false
#   Port 465 (implicit) → SMTP_USE_TLS=false, SMTP_USE_SSL=true
#   Port 25 (plain)     → both false (not recommended)
SMTP_USE_TLS=true
SMTP_USE_SSL=false

SMTP_TIMEOUT_SECONDS=15

# ═══════════════════════════════════════════════════════════════
#  AUDIT LOG
# ═══════════════════════════════════════════════════════════════
# Events older than this are deleted on startup. Set to 0 to keep forever.
AUDIT_RETENTION_DAYS=90